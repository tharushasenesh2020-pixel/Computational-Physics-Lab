    "import numpy as np\n",
    "\n",
    "Angular_velocity = np.array([0, 0, 5])\n",
    "I_moment = np.array([\n",
    "            [3, 0 , 0],\n",
    "            [0, 5, 0],\n",
    "            [0, 0, 4]\n",
    "])\n",
    "\n",
    "L = I_moment * Angular_velocity\n",
    "print(f\"Calculated Angular Momentum (L):\\n{L} kg m^2/s\\n\")"
   ]
