   "source": [
    "import numpy as np\n",
    "\n",
    "Q = 2e-6\n",
    "Angular_velocity = np.array([3, 4, 0])\n",
    "Magnetic_field = np.array([0.0, 0.2, 0.3])\n",
    "\n",
    "Force = Q*np.cross(Angular_velocity, Magnetic_field)\n",
    "print(f\"Calculated magnetic force (Force):\\n{Force} N\")"
   ]
